# ── Progress Agentic RAG connection (required unless ARAG_MOCK=1) ──────────────
ARAG_KB_ID=                       # Knowledge Box id (uuid) of the default prospect
ARAG_API_KEY=                     # KB service-account token (X-NUCLIA-SERVICEACCOUNT). Never commit.
ARAG_REGION=aws-us-east-2-1       # zone slug; or set ARAG_BASE_URL to override the host entirely
#ARAG_BASE_URL=https://aws-us-east-2-1.dp.progress.cloud/api/v1
ARAG_GENERATIVE_MODEL=            # empty = KB default (e.g. chatgpt-azure-4o)
ARAG_RERANKER=predict             # predict | noop
ARAG_TIMEOUT_MS=60000             # client default; the voice turn uses VOICE_TURN_TIMEOUT_MS
ARAG_MOCK=0                       # 1 = use the in-process mock ARAG (no credentials needed)

# ── Service ────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data                   # JSON stores: prospects.json, turns.json, jobs.json, golden-evals.json
PUBLIC_URL=http://localhost:8080

# ── Security ───────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                      # required to open /admin and /api/v1/admin/*; generate: openssl rand -hex 24
API_KEYS=                         # comma-separated; when set, /api/v1 requires X-API-Key (the console uses a session cookie)
ALLOWED_ORIGINS=                  # comma-separated CORS origins; empty = same-origin only
RATE_LIMIT_RPS=5                  # global per-IP budget for /api/v1
RATE_LIMIT_BURST=20
MAX_BODY_BYTES=1048576
TRUST_PROXY=fly                   # fly | xff | none — which proxy header may set the client IP for rate limits

# ── VoiceBridge: the turn pipeline ─────────────────────────────────────────────
ARAG_REGION_DEFAULT=aws-us-east-2-1  # zone used when a prospect entry omits `region`
VOICE_TURN_TIMEOUT_MS=6000        # per-turn ARAG budget; MUST stay below AGENT_TOOL_TIMEOUT_MS
AGENT_TOOL_TIMEOUT_MS=8000        # the timeout configured on the voice agent's custom tool
VOICE_BRIEF_TIMEOUT_MS=12000      # Listen-mode brief budget (not blocking speech)
MAX_HISTORY_TURNS=6               # prior turns forwarded to ARAG as `context` (1 turn = USER + NUCLIA)
VOICE_TURN_LOG_LIMIT=500          # ring size of the admin turn log
VOICE_BRIEF_RATE_RPS=1            # stricter per-IP budget for /api/v1/brief and listen sessions
                                  # (both spend an LLM call per refresh; listening fires continuously)
VOICE_BRIEF_RATE_BURST=5
VOICE_SCRIBE_RATE_RPS=0.2         # per-IP budget for minting ElevenLabs Scribe tokens
VOICE_SCRIBE_RATE_BURST=3
VOICE_TTS_RATE_RPS=1              # per-IP budget for the optional spoken brief (costs per character)
VOICE_TTS_RATE_BURST=6
VOICE_DEFAULT_AGENT_ID=           # ElevenLabs agent id seeded into the first prospect (non-secret, but
                                  # kept out of git so the shipped example registry has no real ids)
VOICE_KB_TITLE=                   # optional label for the deployment's Knowledge Box (docs/demos only)

# ── White-label branding (optional) ────────────────────────────────────────────
# A partner rebrands a deployment with these alone — no fork, no code change. The console and
# the admin panel read GET /api/v1/branding at boot; per-prospect overrides (registry `brand`
# block) layer on top. See docs/developer/white-label.md.
BRAND_PRODUCT_NAME=               # default: VoiceBridge
BRAND_TAGLINE=                    # default: live, grounded call context
BRAND_LOGO_URL=                   # absolute URL, or /branding/logo.svg served from DATA_DIR/branding/
BRAND_PRIMARY_COLOR=              # any CSS colour, e.g. #6b2fa0
BRAND_ACCENT_COLOR=
BRAND_POWERED_BY=1                # 0 hides the "Built on Progress Agentic RAG" credit in the UI
                                  # (attribution still lives in LICENSE and THIRD_PARTY_NOTICES.md)
BRAND_FOOTER_TEXT=                # default: Open source · Apache-2.0
BRAND_DOCS_URL=                   # default: /api/v1/docs
BRAND_SUPPORT_URL=                # shown as the support link when set

# ── ElevenLabs (the default voice and transcription stack) ─────────────────────
# With a key set, the product is ElevenLabs-powered out of the box: Scribe v2 Realtime is the
# default microphone transcription in Live, ElevenLabs Conversational AI is the default voice
# channel (it calls /api/v1/voice-answer as a custom server tool), and the optional spoken brief
# uses ElevenLabs text-to-speech. Without a key the product still works end to end — the sample
# conversation, typed text and the telephony webhook feed the same vendor-neutral session API.
ELEVENLABS_API_KEY=               # server-side only; mints single-use Scribe tokens, lists voices, synthesises speech
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_SCRIBE_MODEL=scribe_v2_realtime   # realtime transcription model used by the Live microphone
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5       # low-latency model for the spoken brief
ELEVENLABS_TTS_VOICE_ID=          # default voice for the spoken brief; a prospect's voice_id wins

