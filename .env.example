# ──────────────────────────────────────────────────────────────────────────
# ask-bridge environment. Copy to bridge/.env and fill in.
# SECRETS LIVE ONLY HERE (and in Fly.io secrets) — never client-side, never in the repo.
# ──────────────────────────────────────────────────────────────────────────

# --- Secrets (required) ---
# ARAG / Nuclia service-account token. Sent as: X-NUCLIA-SERVICEACCOUNT: Bearer <token>
ARAG_TOKEN=

# ElevenLabs API key. Only needed if the bridge ever talks to ElevenLabs directly
# (the agent template normally holds this). Kept here so nothing sensitive is client-side.
ELEVENLABS_API_KEY=

# --- Bridge runtime ---
PORT=8080
NODE_ENV=development

# Default ARAG region used when a prospect registry entry omits `region`.
ARAG_REGION_DEFAULT=europe-1

# Timeouts (ms). Keep ARAG_TIMEOUT_MS < AGENT_TOOL_TIMEOUT_MS so the bridge always
# resolves a turn before the agent's tool call gives up (avoids dead air).
ARAG_TIMEOUT_MS=6000
AGENT_TOOL_TIMEOUT_MS=8000

# Where the control panel/agent reaches the bridge (informational; used by client config).
ASK_BRIDGE_URL=http://localhost:8080

# Max prior turns of conversation history forwarded to ARAG as `context`
# (bounds generation latency/cost). Each turn = one USER + one NUCLIA message.
MAX_HISTORY_TURNS=6

# Comma-separated origins allowed to call the bridge (CORS). Use the control panel origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────────
# LiveAvatar (HeyGen) video avatar — OPTIONAL. The avatar pane stays dormant
# (the /v1/avatar/session endpoint 503s and the UI hides the toggle) until ALL
# of LiveAvatar + LiveKit + an ElevenLabs key/secret are set. See docs/LIVEAVATAR_SETUP.md.
# ──────────────────────────────────────────────────────────────────────────

# HeyGen/LiveAvatar API key (paid). Sent as X-API-KEY.
LIVEAVATAR_API_KEY=
LIVEAVATAR_API_BASE=https://api.liveavatar.com/v1
# Override these if the live API paths differ (verify at integration time).
LIVEAVATAR_SECRETS_PATH=/secrets
LIVEAVATAR_SESSION_PATH=/sessions

# Either pre-register the ElevenLabs key with LiveAvatar and paste the secret_id here…
LIVEAVATAR_ELEVENLABS_SECRET_ID=
# …or give the bridge a paid ElevenLabs API key (scopes: convai_read, user_read, voices_read)
# and it will register it once on first use. Server-side only.
ELEVENLABS_API_KEY=

# LiveKit Cloud (has a free tier). The bridge mints room tokens with these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
